# Environment for the integration test suite (`yarn test`).
# Only dummy values: every outgoing HTTP request is intercepted by MSW, and
# DATABASE_URL is injected at runtime from the MariaDB test container.
NODE_ENV="test"
AWS_CLIENT_ID="test-aws-id"
AWS_CLIENT_SECRET="test-aws-secret"
ENABLE_AWS_SES_EMAILS="true"
NEXTAUTH_SECRET="test-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
WORDPRESS_API_KEY="test-wp-key"
CRON_KEY="test-cron-key"
CANCELLATION_URL="http://localhost:3000/bortaresor/avboka"
MEMBERSHIP_URL="http://localhost:3000/medlem"
API_URL="http://localhost:3000/api"
BOOKING_EMAIL="booking@test.vastrasidan.se"
STRIPE_API_KEY="sk_test_fake"
STRIPE_WEBHOOK_SECRET="whsec_test_secret"
USE_DEV_MODE="false"
CARDSKIPPER_USERNAME="test"
CARDSKIPPER_PASSWORD="test"
CARDSKIPPER_ORG_NUMBER="test"
WEBSITE_URL="http://localhost:3000"
NEXT_PUBLIC_WORDPRESS_URL="http://wordpress.test"
NEXT_PUBLIC_ENABLE_MEMBERSHIPS="true"
NEXT_PUBLIC_ENABLE_LOGIN="true"
NEXT_PUBLIC_ENABLE_AWAYGAMES="true"
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_STRIPE_API_KEY="pk_test_fake"
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"
