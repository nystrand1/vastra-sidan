[Unit]
Description=Vastra Sidan website (Next.js standalone)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
# Releases belong to the deploy user. The app can only write its caches:
# shared/cache and each release's .next/server/route-cache (ISR pages).
User=vss-event
Group=vss-event
# Group-writable, so the deploy user can prune old releases
UMask=0002
WorkingDirectory=/srv/vss-event/current
EnvironmentFile=/srv/vss-event/shared/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
# The box has 2 GB shared with MySQL and WordPress. Keep the V8 heap bounded.
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStart=/usr/bin/node server.js
# Next exits with 143 on SIGTERM
SuccessExitStatus=143
Restart=on-failure
RestartSec=3
MemoryMax=900M

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/vss-event/shared/cache /srv/vss-event/releases

[Install]
WantedBy=multi-user.target
